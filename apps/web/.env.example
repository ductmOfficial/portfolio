# Optional. Copy to apps/web/.env.local to override: cp apps/web/.env.example apps/web/.env.local
# The site runs without any of these.

# Canonical origin for metadata, the sitemap and share images. Defaults to the production URL.
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# "verified" (default) shows only verified CV content; "target" also shows roadmap items (preview only).
# NEXT_PUBLIC_CV_MODE=verified
