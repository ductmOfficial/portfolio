{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3500",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3500/en",
        "http://localhost:3500/en/work/multi-tenant-wms",
        "http://localhost:3500/de/experience",
        "http://localhost:3500/vi/skills",
        "http://localhost:3500/en/cv"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 600 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 204800 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 512000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
